{
  "name": "ai-navigation-visually-impaired",
  "version": "1.0.0",
  "description": "AI-based navigation assistance system for visually impaired users",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --run",
    "test:watch": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "fast-check": "^3.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "dependencies": {
    "node-record-lpcm16": "^1.0.1",
    "node-webcam": "^0.8.2",
    "onnxruntime-node": "^1.24.3",
    "play-sound": "^1.1.6",
    "say": "^0.16.0"
  }
}
